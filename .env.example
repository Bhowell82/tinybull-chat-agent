# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- LiveChat (Agent Chat API, personal access token) ---
# Create a bot/agent account for the AI so its messages show a distinct name.
LIVECHAT_ACCOUNT_ID=
LIVECHAT_PAT=
# RTM websocket (default on): LiveChat pushes visitor messages over one persistent connection using the PAT.
RTM_ENABLED=1
# Optional, only if RTM login complains: your Text organization ID and region (e.g. dal)
LIVECHAT_ORGANIZATION_ID=
LIVECHAT_REGION=
# Webhook (optional; needs a Developer Console app). With BOTH set, the service registers the LiveChat webhook itself on boot.
# The PAT needs scope webhooks.configuration:rw. Client ID is in Developer Console > your app > Authorization.
LIVECHAT_WEBHOOK_SECRET=
LIVECHAT_CLIENT_ID=
# Public base URL for the webhook. Not needed on Railway (RAILWAY_PUBLIC_DOMAIN is used automatically).
PUBLIC_URL=
# Set to 0 to register the webhook by hand instead
WEBHOOK_AUTO_REGISTER=1
# Polling: checks LiveChat for new visitor messages using only the PAT.
# Defaults to every 5 min as a safety net when a webhook is configured, every 5 s otherwise.
POLL_ENABLED=1
POLL_INTERVAL_MS=
# Agent ID (email) of the account the PAT belongs to. Required so the bot can tell its own messages from a human teammate's
LIVECHAT_BOT_AGENT_ID=

# --- Behavior ---
# suggest = post a PRIVATE draft only your team sees (start here)
# auto    = reply to the visitor directly
AGENT_MODE=suggest
# Wait this long after the last visitor message before replying (batches rapid-fire messages)
DEBOUNCE_MS=3500
# Public name used in the persona
AGENT_NAME=Sam
BOOKING_URL=
TEAM_EMAIL=brett@tinybull.com
TEXT_LINE=(980) 600-2855

# Tags must already exist in LiveChat Settings > Tags
TAG_HOT=lead-hot
TAG_WARM=lead-warm
TAG_COLD=lead-cold
TAG_SPAM=lead-spam

# Optional: Slack incoming webhook to ping the team on hot leads
SLACK_WEBHOOK_URL=

# Local testing only: skips real LiveChat and Claude calls
MOCK=0
PORT=3000

# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- LiveChat (Agent Chat API, personal access token) ---
# Create a bot/agent account for the AI so its messages show a distinct name.
LIVECHAT_ACCOUNT_ID=
LIVECHAT_PAT=
# Must match the secret_key you pass when registering the webhook
LIVECHAT_WEBHOOK_SECRET=
# Agent ID (email) of the account the PAT belongs to. Required so the bot can tell its own messages from a human teammate's
LIVECHAT_BOT_AGENT_ID=

# --- Behavior ---
# suggest = post a PRIVATE draft only your team sees (start here)
# auto    = reply to the visitor directly
AGENT_MODE=suggest
# Wait this long after the last visitor message before replying (batches rapid-fire messages)
DEBOUNCE_MS=3500
# Public name used in the persona
AGENT_NAME=Sam
BOOKING_URL=
TEAM_EMAIL=brett@tinybull.com
TEXT_LINE=(980) 600-2855

# Tags must already exist in LiveChat Settings > Tags
TAG_HOT=lead-hot
TAG_WARM=lead-warm
TAG_COLD=lead-cold
TAG_SPAM=lead-spam

# Optional: Slack incoming webhook to ping the team on hot leads
SLACK_WEBHOOK_URL=

# Local testing only: skips real LiveChat and Claude calls
MOCK=0
PORT=3000
